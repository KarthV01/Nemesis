# Copy this file to .env and replace placeholders with your own credentials.
# Never commit .env or credential files.

# Modal webhook credentials (only needed for webhook integrations).
MODAL_WEBHOOK_KEY=replace-with-your-modal-webhook-key
MODAL_WEBHOOK_SECRET=replace-with-your-modal-webhook-secret

# Modal account credentials used to launch and manage compute.
# Prefer `modal token new`; these variables support non-interactive setups.
MODAL_TOKEN_ID=replace-with-your-modal-token-id
MODAL_TOKEN_SECRET=replace-with-your-modal-token-secret

# Local Ollama-backed LLM agent configuration.
NEMESIS_LLM_MODEL=qwen2.5:1.5b-instruct
OLLAMA_HOST=http://localhost:11434
